rules_version = '2';

// This app never writes to Firestore directly from the browser. Every
// mutation goes through a Next.js Server Action using the Admin SDK
// (service account credentials), which bypasses these rules entirely.
// So: public collections are readable by anyone (the portfolio itself
// needs to render them for visitors) and writable by no one through the
// client SDK. `contact_submissions` holds visitor PII (name/email/message)
// and isn't even publicly readable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /experience/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /skills/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /contact_submissions/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Deny anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
