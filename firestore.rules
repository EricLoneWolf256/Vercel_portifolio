rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Public read-only collections ───────────────────────────────────────
    // All portfolio content is publicly readable.
    // Only authenticated admins can write.

    match /projects/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /experience/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /skills/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Contact submissions ─────────────────────────────────────────────────
    // Anyone can create a submission (contact form).
    // Only authenticated admins can read submissions.

    match /contact_submissions/{document} {
      allow create: if
        // Must have required fields
        request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message']) &&
        // Basic type validation
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.message is string &&
        // Length limits (anti-spam)
        request.resource.data.name.size() <= 100 &&
        request.resource.data.message.size() <= 2000;

      allow read, update, delete: if request.auth != null;
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
