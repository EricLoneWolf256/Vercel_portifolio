# Copy this file to .env.local and fill in your own values.
# See ADMIN_SETUP.md for where to find each of these.

# ─── Firebase (client-side config) ──────────────────────────────────────────
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase (Admin SDK — server-only, keep secret) ────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the "private_key" value from the downloaded JSON exactly, quotes included.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Cloudinary (image/file storage) ────────────────────────────────────────
# Cloudinary Console → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
# The deployed URL of this site (used for SEO/OG tags and the sitemap).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── Admin access ────────────────────────────────────────────────────────────
# The ONLY Google account email allowed to sign in to /admin. Anyone else who
# signs in with Google gets a valid Firebase account but is rejected here.
# Optional — defaults to innocentericmuzamil@gmail.com if unset.
ADMIN_EMAIL=innocentericmuzamil@gmail.com
